<Window
    x:Class="MyFinder.UI.Views.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MyFinder">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Width="300" Height="300">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <FontIcon Glyph="&#xE721;" FontSize="64" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
            <TextBlock Text="MyFinder" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <ProgressRing IsActive="True" Width="24" Height="24" />
            <TextBlock Text="正在加载..." FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
