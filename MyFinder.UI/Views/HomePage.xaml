<Page
    x:Class="MyFinder.UI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="PageRoot">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Action Bar -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16,12">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE721;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="主页搜索" VerticalAlignment="Center" FontSize="20" />
                </StackPanel>

                <Button HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="刷新">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
            </Grid>
        </Border>

        <!-- Search Bar -->
        <AutoSuggestBox
            Grid.Row="1"
            Height="40"
            PlaceholderText="搜索文件名、扩展名或自然语言（如：上周的图片、.py）"
            QueryIcon="Find"
            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
            TextChanged="AutoSuggestBox_TextChanged"
            QuerySubmitted="AutoSuggestBox_QuerySubmitted" />

        <!-- AI Parsed Description Badge -->
        <Border Grid.Row="2"
                Visibility="{x:Bind ViewModel.AiParsedDescription, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                Background="{ThemeResource SystemAccentColorDark2}"
                CornerRadius="6"
                Padding="12,6"
                HorizontalAlignment="Left">
            <TextBlock Text="{x:Bind ViewModel.AiParsedDescription, Mode=OneWay}"
                       Foreground="White"
                       FontSize="13"
                       FontWeight="Medium" />
        </Border>

        <!-- 可搜索文件夹列表卡片 -->
        <Border Grid.Row="3"
                Padding="16,12"
                CornerRadius="8"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="📂 当前可搜索的文件夹"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.WatchedDirectories, Mode=OneWay}"
                          SelectionMode="None"
                          MaxHeight="120"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,2" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!-- 空状态显示 -->
                <TextBlock Grid.Row="1"
                           Text="暂无索引目录，请前往「设置」添加"
                           Foreground="{ThemeResource TextFillColorDisabledBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{x:Bind ViewModel.HasWatchedDirectories, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                           Margin="0,10,0,10" />
            </Grid>
        </Border>

        <ProgressRing
            Grid.Row="4"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            HorizontalAlignment="Left"
            Width="24" Height="24" />

        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search Results List -->
            <ListView
                Grid.Row="0"
                ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                SelectionMode="None"
                Padding="0,8,0,8"
                IsItemClickEnabled="True"
                ItemClick="ListView_ItemClick"
                Visibility="{x:Bind ViewModel.SearchQuery, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" Margin="0,0,0,4" CornerRadius="4" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7C3;" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding FileName}" FontWeight="Medium" />
                                <TextBlock Text="{Binding Path}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                            <Grid.ContextFlyout>
                                <MenuFlyout Opening="MenuFlyout_Opening">
                                    <MenuFlyoutItem Text="📄 打开文件" Click="OnOpenFileClick" Tag="{Binding}" />
                                    <MenuFlyoutItem Text="🔍 在资源管理器中定位" Click="OnOpenInExplorerClick" Tag="{Binding}" />
                                    <MenuFlyoutItem x:Name="FavoriteMenuItem" Text="⭐ 添加到收藏" Click="OnToggleFavoriteClick" Tag="{Binding}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Search Empty State -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.ShowSearchEmptyState, Mode=OneWay}">
                <FontIcon Glyph="&#xE721;" FontSize="36" Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                <TextBlock Text="未找到匹配的文件" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Recent Files List -->
            <ListView
                Grid.Row="0"
                ItemsSource="{x:Bind ViewModel.RecentFiles, Mode=OneWay}"
                SelectionMode="None"
                Padding="0,8,0,8"
                IsItemClickEnabled="True"
                ItemClick="ListView_ItemClick"
                Visibility="{x:Bind ViewModel.SearchQuery, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" Margin="0,0,0,4" CornerRadius="4" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7C3;" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding FileName}" FontWeight="Medium" />
                                <TextBlock Text="{Binding Path}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                            <Grid.ContextFlyout>
                                <MenuFlyout Opening="MenuFlyout_Opening">
                                    <MenuFlyoutItem Text="📄 打开文件" Click="OnOpenFileClick" Tag="{Binding}" />
                                    <MenuFlyoutItem Text="🔍 在资源管理器中定位" Click="OnOpenInExplorerClick" Tag="{Binding}" />
                                    <MenuFlyoutItem x:Name="FavoriteMenuItem" Text="⭐ 添加到收藏" Click="OnToggleFavoriteClick" Tag="{Binding}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Recent Empty State -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.ShowRecentEmptyState, Mode=OneWay}">
                <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                <TextBlock Text="还没有文件记录，去「设置」或「目录树」添加索引" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,8,0,0" Spacing="8">
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsDeepSearching, Mode=OneWay}"
                    Width="20"
                    Height="20"
                    Visibility="{x:Bind ViewModel.IsDeepSearching, Mode=OneWay}" />
                <HyperlinkButton
                    Content="扩大搜索范围（模糊匹配）"
                    Command="{x:Bind ViewModel.DeepSearchCommand}"
                    Visibility="{x:Bind ViewModel.ShowDeepSearchButton, Mode=OneWay}"
                    ToolTipService.ToolTip="扩展搜索范围" />
            </StackPanel>

            <!-- 提示弹窗 Toast TeachingTip -->
            <TeachingTip x:Name="FavoriteTip" Title="提示" Target="{x:Bind PageRoot}" />
        </Grid>
    </Grid>
</Page>