<Page
    x:Class="MyFinder.UI.Views.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="PageRoot">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16,12">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE735;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="我的收藏" VerticalAlignment="Center" FontSize="20" />
                </StackPanel>

                <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="刷新">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ListView
                ItemsSource="{x:Bind ViewModel.Favorites, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" Margin="0,0,0,4" ColumnSpacing="12" CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE735;" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayAlias}" FontWeight="Medium" />
                                <TextBlock Text="{Binding TargetPath}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                            <Button Grid.Column="2" 
                                    Command="{Binding DataContext.RemoveFavoriteCommand, ElementName=PageRoot}" 
                                    CommandParameter="{Binding Id}" 
                                    ToolTipService.ToolTip="移除">
                                <SymbolIcon Symbol="Delete" />
                            </Button>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="📄 打开" Command="{Binding DataContext.OpenFavoriteCommand, ElementName=PageRoot}" CommandParameter="{Binding}" />
                                    <MenuFlyoutItem Text="🔍 在资源管理器中定位" Command="{Binding DataContext.OpenInExplorerCommand, ElementName=PageRoot}" CommandParameter="{Binding}" />
                                    <MenuFlyoutItem Text="❌ 移除" Command="{Binding DataContext.RemoveFavoriteCommand, ElementName=PageRoot}" CommandParameter="{Binding Id}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="48" Height="48" />
        </Grid>
    </Grid>
</Page>