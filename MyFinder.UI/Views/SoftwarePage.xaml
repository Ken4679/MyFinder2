<Page
    x:Class="MyFinder.UI.Views.SoftwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Action Bar -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16,12">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE71D;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="我的软件" VerticalAlignment="Center" FontSize="20" />
                </StackPanel>

                <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.RefreshSoftwareCommand}" Style="{StaticResource DefaultButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="🔄 重新扫描软件" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ListView
                ItemsSource="{x:Bind ViewModel.SoftwareList, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedSoftware, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="32" Height="32">
                                <Image
                                    Source="{Binding MainExePath, Converter={StaticResource IconPathToImageConverter}}"
                                    Width="32"
                                    Height="32"
                                    Visibility="{Binding MainExePath, Converter={StaticResource FileExistsToVisibilityConverter}}" />
                                <FontIcon
                                    Glyph="&#xE71D;"
                                    FontSize="24"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding MainExePath, Converter={StaticResource FileExistsToVisibilityConverter}, ConverterParameter=Reverse}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="{Binding Publisher}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Version}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="48" Height="48" />
        </Grid>
    </Grid>
</Page>