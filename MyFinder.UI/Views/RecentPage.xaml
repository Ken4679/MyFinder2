<Page
    x:Class="MyFinder.UI.Views.RecentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="PageRoot">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="最近文件" VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="刷新">
                <SymbolIcon Symbol="Refresh" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ListView
                ItemsSource="{x:Bind ViewModel.RecentFiles, Mode=OneWay}"
                SelectionMode="None"
                Padding="0,8,0,8">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" Margin="0,0,0,4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7C3;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding FileName}" FontWeight="Medium" />
                                <TextBlock Text="{Binding Path}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding UpdatedTime}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="📂 打开文件" Command="{Binding DataContext.OpenFileCommand, ElementName=PageRoot}" CommandParameter="{Binding}" />
                                    <MenuFlyoutItem Text="📁 在资源管理器中显示" Command="{Binding DataContext.OpenInExplorerCommand, ElementName=PageRoot}" CommandParameter="{Binding}" />
                                    <MenuFlyoutItem Text="⭐ 添加到收藏" Command="{Binding DataContext.AddToFavoritesCommand, ElementName=PageRoot}" CommandParameter="{Binding}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="48" Height="48" />
        </Grid>
    </Grid>
</Page>